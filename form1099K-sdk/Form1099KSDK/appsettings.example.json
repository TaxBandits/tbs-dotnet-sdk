{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "OAUTH_API_URL": "https://oauth.spanstage.com/v2/tbsauth",
    "TBS_PUBLIC_API_BASE_URL": "https://tbs-api.spanstage.com/V1.7.3/",
    "ClientId": "YOUR_CLIENT_ID_HERE",
    "ClientSecret": "YOUR_CLIENT_SECRET_HERE",
    "UserToken": "YOUR_USER_TOKEN_HERE",
    "BucketName": "YOUR_BUCKET_NAME_HERE",
    "Base64Key": "YOUR_BASE64_ENCRYPTION_KEY_HERE",
    "AmazonS3Path": "https://your-bucket.s3.your-region.amazonaws.com/",
    "AWSAccessKey": "YOUR_AWS_ACCESS_KEY_HERE",
    "AWSSecretKey": "YOUR_AWS_SECRET_KEY_HERE"
  }
}